    "expand:medicines": "npx tsx scripts/expand-medicines-ai.ts",
    "seed:medicines": "npx tsx scripts/seed-medicines.ts",
    "seed:medicines:preview": "npx tsx scripts/expand-medicines-ai.ts --preview-only",
    "seed:medicines:reset": "npx tsx scripts/seed-medicines.ts --mode=reset --yes",
    "clean:duplicates": "npx tsx scripts/clean-duplicates.ts",
    "clean:duplicates:execute": "npx tsx scripts/clean-duplicates.ts --execute",
    "test:contract": "jest --config=test/contract/jest.config.js",
    "test:contract:format": "jest --config=test/contract/jest.config.js test/contract/response-format.contract.spec.ts",
    "test:contract:endpoints": "jest --config=test/contract/jest.config.js test/contract/endpoints.contract.spec.ts",
    "test:contract:demo": "jest --config=test/contract/jest.config.js test/contract/endpoints-demo.contract.spec.ts",
    "monitoring:dashboard": "start monitoring-dashboard.html",
    "monitoring:status": "npx tsx scripts/monitoring-dashboard.ts",
    "monitoring:enable": "node scripts/monitoring-enable-performance.js",
    "monitoring:logs": "tail -f logs/performance.log"
  },
