  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "ci-check": "node scripts/local-ci-check.js",
    "ci-check:quick": "npm run lint:check && npm run format:check && npx tsc --noEmit",
    "install-hooks": "node scripts/install-git-hooks.js",
    "pre-commit": "node scripts/pre-commit-check.js",
    "pre-push": "npm run ci-check",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:reset": "npx prisma migrate reset",
    "db:seed": "npx prisma db seed",
    "db:check-medicines-data": "npx tsx scripts/db-check-medicines-data.ts",
    "search:rebuild-index": "npx tsx scripts/search-rebuild-index.ts",
    "monitoring:enable-performance": "npx tsx scripts/monitoring-enable-performance.ts",
