// 🔄 原Prisma Schema - 后端代码复用资产
// 复用价值: 95% (核心数据模型和业务逻辑)
// 迁移目标: Supabase PostgreSQL + RLS策略
// 适配要求: 转换为Supabase Migration SQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid()) @map("id")
  email               String               @unique @map("email") @db.VarChar(255)
  role                UserRole             @map("role")
  status              UserStatus           @default(pending) @map("status")
  referralCode        String?              @unique @map("referral_code") @db.VarChar(10)
  referredBy          String?              @map("referred_by")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  password            String               @default("password_not_set_for_existing_user") @map("password")
  refreshToken        String?              @map("refresh_token") @db.VarChar(64)
  refreshTokenExp     DateTime?            @map("refresh_token_exp") @db.Timestamptz(6)
  accountTransactions AccountTransaction[] @relation("CreatedBy")
  fulfillmentReviews  FulfillmentProof[]   @relation("Reviewer")
  patientOrders       Order[]              @relation("PatientOrders")
  practitionerOrders  Order[]              @relation("PractitionerOrders")
  operatedPharmacy    Pharmacy?            @relation("PharmacyOperator")
  practitionerAccount PractitionerAccount?
  prescriptions       Prescription[]       @relation("PractitionerPrescriptions")
  profile             UserProfile?
  referredByUser      User?                @relation("Referrals", fields: [referredBy], references: [id])
  referrals           User[]               @relation("Referrals")
  apiCallLogs         ApiCallLog[]         @relation("ApiCallLogs")
  apiCallMetrics      ApiCallMetrics[]     @relation("ApiCallMetrics")

  @@index([role])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id              String    @id @default(cuid()) @map("id")
  userId          String    @unique @map("user_id")
  fullName        String    @map("full_name") @db.VarChar(255)
  phone           String?   @map("phone") @db.VarChar(20)
  licenseNumber   String?   @unique @map("license_number") @db.VarChar(50)
  address         Json?     @map("address")
  preferences     Json?     @map("preferences")
  metadata        Json?     @map("metadata")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  specialization  String?   @db.VarChar(100)
  clinic          String?   @db.VarChar(255)
  qualifications  Json?     @db.Json
  apc_expiry_date DateTime? @db.Date
  apc_file_url    String?   @db.VarChar(500)
  apc_upload_date DateTime? @db.Timestamp(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apc_expiry_date], map: "idx_user_profiles_apc_expiry")
  @@index([specialization], map: "idx_user_profiles_specialization")
  @@map("user_profiles")
}

model PractitionerAccount {
  id              String               @id @default(cuid()) @map("id")
  practitionerId  String               @unique @map("practitioner_id")
  balance         Decimal              @default(0) @map("balance") @db.Decimal(12, 2)
  creditLimit     Decimal              @default(0) @map("credit_limit") @db.Decimal(12, 2)
  usedCredit      Decimal              @default(0) @map("used_credit") @db.Decimal(12, 2)
  availableCredit Decimal?             @map("available_credit") @db.Decimal(12, 2)
  status          AccountStatus        @default(active) @map("status")
  version         Int                  @default(1) @map("version")
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  transactions    AccountTransaction[]
  practitioner    User                 @relation(fields: [practitionerId], references: [id])

  @@index([status])
  @@map("practitioner_accounts")
}

model AccountTransaction {
  id              String              @id @default(cuid()) @map("id")
  accountId       String              @map("account_id")
  transactionType TransactionType     @map("transaction_type")
  amount          Decimal             @map("amount") @db.Decimal(12, 2)
  balanceBefore   Decimal             @map("balance_before") @db.Decimal(12, 2)
  balanceAfter    Decimal             @map("balance_after") @db.Decimal(12, 2)
  creditBefore    Decimal             @map("credit_before") @db.Decimal(12, 2)
  creditAfter     Decimal             @map("credit_after") @db.Decimal(12, 2)
  referenceType   ReferenceType?      @map("reference_type")
  referenceId     String?             @map("reference_id")
  description     String?             @map("description")
  createdBy       String?             @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  account         PractitionerAccount @relation(fields: [accountId], references: [id])
  creator         User?               @relation("CreatedBy", fields: [createdBy], references: [id])

  @@index([accountId])
  @@index([createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([accountId, transactionType])
  @@index([referenceType, referenceId, createdAt(sort: Desc)])
  @@map("account_transactions")
}

model Medicine {
  id                    String                 @id @default(cuid()) @map("id")
  name                  String                 @map("name") @db.VarChar(255)
  chineseName           String?                @map("chinese_name") @db.VarChar(255)
  englishName           String?                @map("english_name") @db.VarChar(255)
  pinyinName            String?                @map("pinyin_name") @db.VarChar(255)
  sku                   String                 @unique @map("sku") @db.VarChar(100)
  description           String?                @map("description")
  category              String?                @map("category") @db.VarChar(100)
  unit                  String                 @map("unit") @db.VarChar(50)
  requiresPrescription  Boolean                @default(true) @map("requires_prescription")
  basePrice             Decimal                @map("base_price") @db.Decimal(10, 6)
  metadata              Json?                  @map("metadata")
  status                String                 @default("active") @map("status") @db.VarChar(20)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems            OrderItem[]
  pharmacyInventory     PharmacyInventory[]
  prescriptionMedicines PrescriptionMedicine[] @relation("PrescriptionMedicines")

  @@index([name])
  @@index([category])
  @@index([status])
  @@map("medicines")
}

model Pharmacy {
  id                 String              @id @default(cuid()) @map("id")
  name               String              @map("name") @db.VarChar(255)
  address            Json                @map("address")
  coordinates        String?             @map("coordinates")
  contact            Json                @map("contact")
  licenseInfo        Json?               @map("license_info")
  operatorId         String              @unique @map("operator_id")
  serviceHours       Json?               @map("service_hours")
  status             String              @default("active") @map("status") @db.VarChar(20)
  metadata           Json?               @map("metadata")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  fulfillmentProofs  FulfillmentProof[]
  assignedOrders     Order[]             @relation("AssignedPharmacy")
  operator           User                @relation("PharmacyOperator", fields: [operatorId], references: [id])
  account            PharmacyAccount?
  inventory          PharmacyInventory[]
  priceLists         PharmacyPriceList[]
  purchaseOrders     PurchaseOrder[]
  settlements        Settlement[]
  withdrawalRequests WithdrawalRequest[]

  @@index([status])
  @@map("pharmacies")
}

model PharmacyInventory {
  id             String    @id @default(cuid()) @map("id")
  pharmacyId     String    @map("pharmacy_id")
  medicineId     String    @map("medicine_id")
  quantity       Int       @default(0) @map("quantity")
  wholesalePrice Decimal?  @map("wholesale_price") @db.Decimal(10, 2)
  retailPrice    Decimal?  @map("retail_price") @db.Decimal(10, 2)
  lastRestocked  DateTime? @map("last_restocked") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  medicine       Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  pharmacy       Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, medicineId])
  @@map("pharmacy_inventory")
}

model Order {
  id                 String             @id @default(cuid()) @map("id")
  platformOrderId    String             @unique @map("platform_order_id") @db.VarChar(50)
  practitionerId     String             @map("practitioner_id")
  patientId          String?            @map("patient_id")
  status             OrderStatus        @default(DRAFT) @map("status")
  totalAmount        Decimal            @map("total_amount") @db.Decimal(10, 2)
  paymentStatus      String?            @default("pending") @map("payment_status") @db.VarChar(20)
  paymentMethod      String?            @map("payment_method") @db.VarChar(50)
  assignedPharmacyId String?            @map("assigned_pharmacy_id")
  dispensedAt        DateTime?          @map("dispensed_at") @db.Timestamptz(6)
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz(6)
  qrCodeData         String?            @map("qr_code_data")
  pdfUrl             String?            @map("pdf_url")
  notes              String?            @map("notes")
  version            Int                @default(1) @map("version")
  idempotencyKey     String?            @unique @map("idempotency_key") @db.VarChar(255)
  expiresAt          DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  copies             Int                @map("copies")
  fulfillmentProofs  FulfillmentProof[]
  items              OrderItem[]
  assignedPharmacy   Pharmacy?          @relation("AssignedPharmacy", fields: [assignedPharmacyId], references: [id])
  patient            User?              @relation("PatientOrders", fields: [patientId], references: [id])
  practitioner       User               @relation("PractitionerOrders", fields: [practitionerId], references: [id])
  payments           Payment[]
  purchaseOrders     PurchaseOrder[]
  settlements        Settlement[]

  @@index([status])
  @@index([practitionerId])
  @@index([createdAt(sort: Desc)])
  @@index([practitionerId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(cuid()) @map("id")
  orderId            String   @map("order_id")
  medicineId         String   @map("medicine_id")
  medicineSnapshot   Json     @map("medicine_snapshot")
  quantity           Int      @map("quantity")
  unitPrice          Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice         Decimal  @map("total_price") @db.Decimal(10, 2)
  dosageInstructions String?  @map("dosage_instructions")
  notes              String?  @map("notes")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  medicine           Medicine @relation(fields: [medicineId], references: [id])
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id                    String        @id @default(cuid()) @map("id")
  orderId               String        @map("order_id")
  amount                Decimal       @map("amount") @db.Decimal(10, 2)
  currency              String        @default("NZD") @map("currency") @db.VarChar(3)
  paymentMethod         String        @map("payment_method") @db.VarChar(50)
  provider              String?       @map("provider") @db.VarChar(50)
  providerTransactionId String?       @map("provider_transaction_id") @db.VarChar(255)
  providerResponse      Json?         @map("provider_response")
  status                PaymentStatus @default(pending) @map("status")
  processedAt           DateTime?     @map("processed_at") @db.Timestamptz(6)
  metadata              Json?         @map("metadata")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model FulfillmentProof {
  id            String                  @id @default(cuid()) @map("id")
  orderId       String                  @map("order_id")
  pharmacyId    String                  @map("pharmacy_id")
  proofFiles    Json                    @map("proof_files")
  notes         String?                 @map("notes")
  reviewStatus  FulfillmentReviewStatus @default(pending) @map("review_status")
  reviewerId    String?                 @map("reviewer_id")
  reviewNotes   String?                 @map("review_notes")
  reviewedAt    DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  metadata      Json?                   @map("metadata")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacy      Pharmacy                @relation(fields: [pharmacyId], references: [id])
  reviewer      User?                   @relation("Reviewer", fields: [reviewerId], references: [id])
  purchaseOrder PurchaseOrder?

  @@index([orderId])
  @@index([pharmacyId])
  @@index([reviewStatus])
  @@map("fulfillment_proofs")
}

model Settlement {
  id         String    @id @default(cuid()) @map("id")
  orderId    String    @map("order_id")
  pharmacyId String    @map("pharmacy_id")
  amount     Decimal   @map("amount") @db.Decimal(10, 2)
  currency   String    @default("NZD") @map("currency") @db.VarChar(3)
  status     String    @default("pending") @map("status") @db.VarChar(20)
  paidAt     DateTime? @map("paid_at") @db.Timestamptz(6)
  paymentRef String?   @map("payment_ref") @db.VarChar(255)
  metadata   Json?     @map("metadata")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  order      Order     @relation(fields: [orderId], references: [id])
  pharmacy   Pharmacy  @relation(fields: [pharmacyId], references: [id])

  @@map("settlements")
}

model SystemConfig {
  key         String   @id @map("key") @db.VarChar(255)
  value       Json     @map("value")
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_configs")
}

model EventLog {
  id                  String                @id @default(cuid()) @map("id")
  eventType           String                @map("event_type") @db.VarChar(100)
  eventId             String?               @map("event_id") @db.VarChar(255)
  payload             Json                  @map("payload")
  metadata            Json?                 @map("metadata")
  processingStatus    EventProcessingStatus @default(PENDING) @map("processing_status")
  processingAttempts  Int                   @default(0) @map("processing_attempts")
  lastProcessingError String?               @map("last_processing_error")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  processedAt         DateTime?             @map("processed_at") @db.Timestamptz(6)

  @@index([eventType])
  @@index([processingStatus])
  @@index([createdAt])
  @@index([eventType, createdAt])
  @@map("event_logs")
}

model PharmacyAccount {
  id            String                       @id @default(cuid()) @map("id")
  pharmacyId    String                       @unique @map("pharmacy_id")
  balance       Decimal                      @default(0) @map("balance") @db.Decimal(12, 2)
  pendingAmount Decimal                      @default(0) @map("pending_amount") @db.Decimal(12, 2)
  status        String                       @default("active") @map("status")
  version       Int                          @default(1) @map("version")
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  transactions  PharmacyAccountTransaction[]
  pharmacy      Pharmacy                     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("pharmacy_accounts")
}

model PharmacyAccountTransaction {
  id              String          @id @default(cuid()) @map("id")
  accountId       String          @map("account_id")
  transactionType String          @map("transaction_type")
  amount          Decimal         @map("amount") @db.Decimal(12, 2)
  balanceBefore   Decimal         @map("balance_before") @db.Decimal(12, 2)
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(12, 2)
  referenceType   String?         @map("reference_type")
  referenceId     String?         @map("reference_id")
  description     String?         @map("description")
  createdBy       String?         @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  account         PharmacyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("pharmacy_account_transactions")
}

model PurchaseOrder {
  id                 String           @id @default(cuid()) @map("id")
  poNumber           String           @unique @map("po_number")
  pharmacyId         String           @map("pharmacy_id")
  orderId            String           @map("order_id")
  prescriptionId     String?          @map("prescription_id")
  fulfillmentProofId String           @unique @map("fulfillment_proof_id")
  items              Json             @map("items")
  medicineItems      Json?            @map("medicine_items")
  totalAmount        Decimal          @map("total_amount") @db.Decimal(12, 2)
  gstAmount          Decimal?         @map("gst_amount") @db.Decimal(12, 2)
  netAmount          Decimal?         @map("net_amount") @db.Decimal(12, 2)
  status             String           @default("pending_review") @map("status")
  reviewNotes        String?          @map("review_notes")
  reviewedBy         String?          @map("reviewed_by")
  reviewedAt         DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  fulfillmentProof   FulfillmentProof @relation(fields: [fulfillmentProofId], references: [id], onDelete: Cascade)
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacy           Pharmacy         @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription       Prescription?    @relation(fields: [prescriptionId], references: [id])

  @@index([prescriptionId])
  @@map("purchase_orders")
}

model PharmacyPriceList {
  id            String    @id @default(cuid()) @map("id")
  pharmacyId    String    @map("pharmacy_id")
  version       Int       @map("version")
  effectiveDate DateTime  @map("effective_date") @db.Date
  items         Json      @map("items")
  status        String    @default("pending_approval") @map("status")
  notes         String?   @map("notes")
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  pharmacy      Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("pharmacy_price_lists")
}

model WithdrawalRequest {
  id               String    @id @default(cuid()) @map("id")
  pharmacyId       String    @map("pharmacy_id")
  invoiceNumber    String    @unique @map("invoice_number")
  purchaseOrderIds Json      @map("purchase_order_ids")
  totalAmount      Decimal   @map("total_amount") @db.Decimal(12, 2)
  bankDetails      Json      @map("bank_details")
  status           String    @default("pending_review") @map("status")
  notes            String?   @map("notes")
  processedBy      String?   @map("processed_by")
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  pharmacy         Pharmacy  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@map("withdrawal_requests")
}

model Prescription {
  id             String                 @id @default(cuid()) @map("id")
  prescriptionId String                 @unique @map("prescription_id")
  doctorId       String                 @map("doctor_id")
  status         String                 @default("DRAFT") @map("status")
  totalAmount    Decimal                @map("total_amount") @db.Decimal(12, 2)
  notes          String?                @map("notes")
  qrCodeData     String?                @map("qr_code_data")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int                    @default(1) @map("version")
  copies         Int                    @map("copies")
  expiresAt      DateTime?              @map("expires_at") @db.Timestamptz(6)
  paymentMethod  String?                @map("payment_method") @db.VarChar(50)
  paymentStatus  String?                @default("pending") @map("payment_status") @db.VarChar(20)
  medicines      PrescriptionMedicine[]
  practitioner   User                   @relation("PractitionerPrescriptions", fields: [doctorId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([doctorId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([doctorId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("prescriptions")
}

model PrescriptionMedicine {
  id                 String       @id @default(cuid()) @map("id")
  prescriptionId     String       @map("prescription_id")
  medicineId         String       @map("medicine_id")
  dosageInstructions String       @map("dosage_instructions")
  notes              String?      @map("notes")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  weight             Decimal      @map("weight") @db.Decimal(8, 2)
  additionalNotes    String?      @map("additional_notes")
  medicine           Medicine     @relation("PrescriptionMedicines", fields: [medicineId], references: [id], onDelete: Cascade)
  prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@index([medicineId])
  @@map("prescription_medicines")
}

enum UserRole {
  practitioner
  patient
  pharmacy_operator
  admin
}

enum UserStatus {
  pending
  approved
  suspended
}

enum OrderStatus {
  DRAFT
  PAYMENT_FAILED
  PAID
  PENDING_REVIEW
  REJECTED
  FULFILLED
  CANCELLED
  EXPIRED
  PROCESSING
  READY_FOR_PICKUP
  COMPLETED
}

enum PaymentStatus {
  pending
  processing
  completed
  failed
  refunded
}

enum FulfillmentReviewStatus {
  pending
  approved
  rejected
}

enum TransactionType {
  DEBIT
  CREDIT
  REFUND
  ADJUSTMENT
}

enum ReferenceType {
  ORDER
  RECHARGE
  REFUND
  MANUAL
}

enum AccountStatus {
  active
  suspended
  frozen
}

enum EventProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
}

model BatchInvoiceProcessing {
  id                     String    @id @default(cuid()) @map("id")
  batchName              String    @map("batch_name") @db.VarChar(255)
  status                 BatchProcessingStatus @default(PROCESSING) @map("status")
  totalPharmacies        Int       @map("total_pharmacies")
  totalInvoices          Int       @map("total_invoices")
  totalAmount            Decimal?  @map("total_amount") @db.Decimal(12, 2)
  successCount           Int       @default(0) @map("success_count")
  failureCount           Int       @default(0) @map("failure_count")
  processingTimeMinutes  Int?      @map("processing_time_minutes")
  metadata               Json?     @map("metadata") // Stores processing options, results, progress
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([status])
  @@index([createdAt])
  @@map("batch_invoice_processing")
}

enum BatchProcessingStatus {
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model ApiCallLog {
  id            String    @id @default(cuid()) @map("id")
  endpoint      String    @map("endpoint") @db.VarChar(255)
  method        String    @map("method") @db.VarChar(10)
  statusCode    Int       @map("status_code")
  userId        String?   @map("user_id")
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  ip            String?   @map("ip") @db.VarChar(45)
  duration      Int       @map("duration") // Response time in milliseconds
  requestSize   Int?      @map("request_size") // Request body size in bytes
  responseSize  Int?      @map("response_size") // Response body size in bytes
  errorMessage  String?   @map("error_message") @db.Text
  requestHeaders   Json?     @map("request_headers")
  queryParams      Json?     @map("query_params")
  requestBody      Json?     @map("request_body") // Optional storage for debugging
  responseBody     Json?     @map("response_body") // Optional storage for debugging
  metadata         Json?     @map("metadata") // Additional context data
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User?     @relation("ApiCallLogs", fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([endpoint, createdAt(sort: Desc)])
  @@index([statusCode, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([endpoint, method])
  @@map("api_call_logs")
}

model ApiCallMetrics {
  id             String   @id @default(cuid()) @map("id")
  endpoint       String   @map("endpoint") @db.VarChar(255)
  method         String?  @map("method") @db.VarChar(10)
  userId         String?  @map("user_id")
  timeWindow     String   @map("time_window") @db.VarChar(20) // 'hourly', 'daily', 'weekly'
  windowStart    DateTime @map("window_start") @db.Timestamptz(6)
  windowEnd      DateTime @map("window_end") @db.Timestamptz(6)
  requestCount   Int      @default(0) @map("request_count")
  avgDuration    Int?     @map("avg_duration") // Average response time in milliseconds
  minDuration    Int?     @map("min_duration")
  maxDuration    Int?     @map("max_duration")
  p95Duration    Int?     @map("p95_duration") // 95th percentile
  p99Duration    Int?     @map("p99_duration") // 99th percentile
  errorCount     Int      @default(0) @map("error_count")
  errorRate      Decimal? @map("error_rate") @db.Decimal(5, 4) // Error rate as percentage (0.0000-1.0000)
  totalDataSize  Int?     @map("total_data_size") // Total bytes transferred
  metadata       Json?    @map("metadata")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User?    @relation("ApiCallMetrics", fields: [userId], references: [id])

  @@unique([endpoint, method, userId, timeWindow, windowStart])
  @@index([endpoint, timeWindow, windowStart])
  @@index([timeWindow, windowStart])
  @@index([userId, timeWindow, windowStart])
  @@map("api_call_metrics")
}