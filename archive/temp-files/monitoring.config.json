    "interval_seconds": 60,
    "log_file": "logs/performance.log",
    "console_output": true
  },
  "day3_special": {
    "medicines_api_monitoring": true,
    "prescription_api_monitoring": true,
    "search_performance_tracking": true,
    "concurrent_request_monitoring": true
  }
}