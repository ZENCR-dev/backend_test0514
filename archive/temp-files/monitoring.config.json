{
  "enabled": true,
  "metrics": {
    "api_response_time": true,
    "database_query_time": true,
    "memory_usage": true,
    "cpu_usage": true,
    "request_count": true,
    "error_rate": true
  },
  "thresholds": {
    "api_response_time_ms": 500,
    "database_query_time_ms": 200,
    "memory_usage_mb": 512,
    "cpu_usage_percent": 80,
